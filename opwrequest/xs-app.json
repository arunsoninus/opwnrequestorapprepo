{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "responseHeaders": [
    { "name": "X-Content-Type-Options", "value": "nosniff" },
    { "name": "Cross-Origin-Resource-Policy", "value": "same-origin" },
    { "name": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" },
    { "name": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'" }
  ],
  "routes": [
    {
      "source": "^/resources/(.*)$",
      "target": "/resources/$1",
      "authenticationType": "none",
      "destination": "ui5"
    },
    {
      "source": "^/test-resources/(.*)$",
      "target": "/test-resources/$1",
      "authenticationType": "none",
      "destination": "ui5"
    },
    {
      "source": "^/v2/catalog/(.*)$",
      "destination": "nusbtputil",
      "csrfProtection": false
    },
    {
      "source": "^/v2/util/(.*)$",
      "destination": "nusbtputil",
      "csrfProtection": false
    },
    {
      "source": "^/odata/v2/cwned/(.*)$",
      "destination": "nusbtpcwsned",
      "csrfProtection": false
    },
    {
      "source": "^/odata/v2/eclaims/(.*)$",
      "destination": "nusbtpeclaim",
      "csrfProtection": false
    },
    {
      "source": "^/v2/attachment/(.*)$",
      "destination": "nusbtputil",
      "csrfProtection": false
    },
    {
      "source": "^/attachment/(.*)$",
      "destination": "nusbtputil",
      "csrfProtection": false
    },
    {
      "source": "^(.*)$",
      "target": "$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa"
    }
  ]
}